<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/chip0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:background="@drawable/chip_cat" android:gravity="center"
            android:paddingTop="7dp" android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" />
        <TextView android:id="@+id/chip1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/chip_cat" android:gravity="center"
            android:paddingTop="7dp" android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" />
        <TextView android:id="@+id/chip2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/chip_cat" android:gravity="center"
            android:paddingTop="7dp" android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/amt" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="@drawable/chip_amt" android:gravity="center"
        android:paddingTop="10dp" android:paddingBottom="10dp" android:textSize="15sp" android:text="฿  แตะเพื่อกรอกจำนวนเงิน" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/btn_out" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:background="@drawable/chip_out" android:gravity="center"
            android:paddingTop="9dp" android:paddingBottom="9dp" android:text="− ใช้" android:textStyle="bold" android:textColor="#D6336C" />
        <TextView android:id="@+id/btn_in" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="5dp" android:background="@drawable/chip_in" android:gravity="center"
            android:paddingTop="9dp" android:paddingBottom="9dp" android:text="+ เติม" android:textStyle="bold" android:textColor="#1B9E74" />
    </LinearLayout>

    <TextView android:id="@+id/left" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="— ฿" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="2" android:ellipsize="end" android:textSize="11sp" />
</LinearLayout>
